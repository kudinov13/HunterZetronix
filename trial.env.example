# === Trial Bot Configuration ===
# Вторая копия бота для тестового клиента (7 дней)
# Копируйте этот файл в trial.env и заполните данными клиента

# === Telegram User Account (Telethon) — данные КЛИЕНТА ===
TG_API_ID=0
TG_API_HASH=
TG_PHONE=
TG_SESSION_NAME=trial_account

# === MTProto Proxy (тот же что у основного бота) ===
TG_MTPROTO_ENABLED=true
TG_MTPROTO_HOST=
TG_MTPROTO_PORT=
TG_MTPROTO_SECRET=

# === SOCKS5/HTTP Proxy (тот же что у основного бота) ===
TG_PROXY_TYPE=socks5
TG_PROXY_HOST=
TG_PROXY_PORT=
TG_PROXY_USERNAME=
TG_PROXY_PASSWORD=

# === Notification Bot (aiogram) — ОТДЕЛЬНЫЙ токен для клиента ===
NOTIF_BOT_TOKEN=
OWNER_TG_ID=0

# === AI Providers (можно использовать те же что у основного) ===
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# === Database — ОТДЕЛЬНАЯ база для клиента ===
DB_PATH=data/trial_bot.db

# === HTTP API port — другой порт ===
API_PORT=8081

# === Trial Settings ===
# Дата окончания триала (YYYY-MM-DD)
TRIAL_EXPIRES=2026-09-16

# === API Token ===
API_TOKEN=

# === Scheduler ===
SCHEDULER_TIMEZONE=Asia/Novosibirsk
